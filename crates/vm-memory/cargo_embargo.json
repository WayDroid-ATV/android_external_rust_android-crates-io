{
  "features": [
    "default",
    "backend-bitmap",
    "backend-mmap",
    "backend-atomic",
    "arc-swap"
  ],
  "module_name_overrides": {
    "libvm_memory": "libvm_memory_android"
  },
  "package": {
    "vm-memory": {
      "device_supported": false,
      "compile_multilib": "first",
      "arch": {
        "arm64": {
          "enabled": true
        },
        "x86_64": {
          "enabled": true
        }
      }
    }
  },
  "run_cargo": false
}
