{
  "run_cargo": false,
  "min_sdk_version": "29",
  "package": {
    "windows-sys": {
    "device_supported": false,
    "add_module_block": "cargo_embargo_target_windows_enabled.bp.fragment"
    }
  },
  "features": [
    "Wdk",	  
    "Wdk_Foundation",	  
    "Wdk_Storage",
    "Wdk_Storage_FileSystem",
    "Wdk_System",
    "Wdk_System_IO",
    "Win32_Foundation",
    "Win32_NetworkManagement_WiFi",
    "Win32_Networking_WinSock",
    "Win32_Security",
    "Win32_Storage",
    "Win32_Storage_FileSystem",
    "Win32_System_IO",
    "Win32_System_Pipes",
    "Win32_System_Threading",
    "Win32_System_WindowsProgramming"
  ]
}
