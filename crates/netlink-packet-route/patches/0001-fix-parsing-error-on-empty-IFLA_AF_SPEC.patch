Subject: [PATCH 1/3] fix parsing error on empty IFLA_AF_SPEC

Signed-off-by: bebecue <109153518+bebecue@users.noreply.github.com>
---
 src/link/attribute.rs | 9 +++------
 1 file changed, 3 insertions(+), 6 deletions(-)

diff --git a/src/link/attribute.rs b/src/link/attribute.rs
index 391bb1f..cb4d666 100644
--- a/src/link/attribute.rs
+++ b/src/link/attribute.rs
@@ -653,12 +653,9 @@ impl<'a, T: AsRef<[u8]> + ?Sized>
                 AddressFamily::Unspec => {
                     let err = "invalid IFLA_AF_SPEC value for AF_UNSPEC";
                     Self::AfSpecUnspec(
-                        VecAfSpecUnspec::parse(
-                            &NlaBuffer::new_checked(&buf.value())
-                                .context(err)?,
-                        )
-                        .context(err)?
-                        .0,
+                        VecAfSpecUnspec::parse(&NlaBuffer::new(&buf.value()))
+                            .context(err)?
+                            .0,
                     )
                 }
