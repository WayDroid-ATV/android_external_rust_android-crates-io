{
  "features": [
    "default",
    "extra_traits",
    "std"
  ],
  "recovery_available": true,
  "min_sdk_version": "29",
  "tests": true,
  "package": {
    "libc": {
      "rulesmk_patch": "patches/rules.mk.diff",
      "add_module_block": "cargo_embargo_target_windows_enabled.bp.fragment"
    }
  },
  "variants": [
    {},
    {
      "package": {
        "libc": {
          "no_std": true
        }
      },
      "features": [],
      "tests": false,
      "generate_androidbp": false,
      "generate_rulesmk": true,
      "run_cargo": false
    },
    {
      "features": [
        "extra_traits"
      ],
      "tests": false,
      "module_name_overrides": {
        "liblibc": "liblibc_nostd"
      },
      "package": {
        "libc": {
          "host_supported": false,
          "no_std": true,
          "force_rlib": true
        }
      }
    }
  ]
}